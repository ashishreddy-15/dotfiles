#!/usr/bin/env bash
# ui-check: guard rails for the look of the desktop.
#
#   scripts/ui-check            run both parts
#   scripts/ui-check static     no desktop needed: magic values, and Theme.qml vs hyprland / kitty / hyprlock
#   scripts/ui-check live       needs the running session: opens and closes every floating surface through
#                               `qs ipc`, times how long it takes to unmap, and reports what is left behind
#
# Exit status is the number of failures (0 = all good).

set -u
root=$(cd "$(dirname "$0")/.." && pwd)
qml=$root/home/quickshell/.config/quickshell
theme=$qml/Theme.qml
look=$root/home/hypr/.config/hypr/modules/look.lua
kitty=$root/home/kitty/.config/kitty/kitty.conf
lock=$root/home/hypr/.config/hypr/hyprlock.conf

fails=0
fail() { printf '  FAIL  %s\n' "$*"; fails=$((fails + 1)); }
ok()   { printf '  ok    %s\n' "$*"; }

# Value of `readonly property <type> <name>: <value>` in Theme.qml (first token, comments stripped).
# tv name: the value (for a colour written `dark ? "#a" : "#b"`, the dark hex); tvl name: the light hex.
tv() { sed -nE -e "s|^ *readonly property [a-z]+ +$1: *dark \? *(\"#[0-9a-fA-F]+\") *:.*|\1|p" -e "s|^ *readonly property [a-z]+ +$1: *([^ /]+).*|\1|p" "$theme" | head -1; }
tvl() { sed -nE "s|^ *readonly property [a-z]+ +$1: *dark \? *\"#[0-9a-fA-F]+\" *: *(\"#[0-9a-fA-F]+\").*|\1|p" "$theme" | head -1; }

# ---------------------------------------------------------------------------------------------------------
static() {
    echo "static: magic values outside Theme.qml"
    local hits
    # Every colour, duration, spring, radius and font size must come from Theme.qml.
    hits=$(cd "$qml" && grep -rnE '"#[0-9a-fA-F]{3,8}"|Qt\.rgba\([^)]*[0-9]|duration: *[0-9]|spring: *[0-9]|damping: *[0-9]|epsilon: *[0-9]|mass: *[0-9]|radius: *[0-9]|pixelSize: *[0-9]|font\.family: *"|font\.pointSize' \
           --include=*.qml . | grep -v '^\./Theme\.qml' || true)
    # Wallpaper.qml builds its scrim from Theme numbers: allow rgba made of 0/1 and a Theme.* alpha.
    hits=$(printf '%s\n' "$hits" | grep -vE 'Qt\.rgba\((0|1), (0|1), (0|1), (Theme\.[A-Za-z]+|0)\)' | sed '/^$/d')
    if [ -n "$hits" ]; then fail "hard-coded look values (use a Theme.* token):"; printf '%s\n' "$hits" | sed 's/^/          /'
    else ok "no hard-coded colours, durations, springs, radii or font sizes"; fi

    # Icons: only through Theme.glyph*, so the whole shell uses one icon set.
    hits=$(cd "$qml" && LC_ALL=C.UTF-8 grep -rnP '[\x{e000}-\x{f8ff}\x{2039}\x{203a}\x{00d7}\x{25cf}\x{2715}\x{2713}]|\\\\u[eEfF][0-9a-fA-F]{3}' --include=*.qml . | grep -v '^\./Theme\.qml' | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' || true)
    if [ -n "$hits" ]; then fail "icon characters written inline (use Theme.glyph*):"; printf '%s\n' "$hits" | sed 's/^/          /'
    else ok "all icons come from Theme.glyph*"; fi

    echo "static: Theme.qml agrees with Hyprland, hyprlock and the kitty font"
    local radius accent border text rounding
    radius=$(tv radiusCard); rounding=$(sed -nE 's/^[[:space:]]*rounding *= *([0-9]+).*/\1/p' "$look")
    [ "$radius" = "$rounding" ] && ok "corner radius $radius = Hyprland rounding" || fail "radiusCard $radius vs Hyprland rounding ${rounding:-?}"

    # Hyprland animation speeds are in units of 100 ms.
    local name ms want
    for pair in durBase:1.4 durFast:0.9 durSlow:2.4; do
        name=${pair%%:*}; want=${pair##*:}; ms=$(tv "$name")
        if grep -qE "speed *= *$want\b" "$look" && [ "$(awk "BEGIN{print $ms/100}")" = "$want" ]; then ok "$name ${ms} ms = Hyprland speed $want"
        else fail "$name ${ms:-?} ms has no matching 'speed = $want' in look.lua"; fi
    done

    # Hyprland native spring curves for windows (springSmooth) and workspaces (springFluid).
    grep -qE 'hl\.curve\("springSmooth".*type *= *"spring"' "$look" && ok "Hyprland defines springSmooth spring curve" || fail "springSmooth spring curve missing from look.lua"
    grep -qE 'hl\.curve\("springFluid".*type *= *"spring"' "$look" && ok "Hyprland defines springFluid spring curve" || fail "springFluid spring curve missing from look.lua"
    grep -qE 'spring *= *"springSmooth"' "$look" && ok "Hyprland binds springSmooth (windows)" || fail "springSmooth binding missing from look.lua"
    grep -qE 'spring *= *"springFluid"' "$look" && ok "Hyprland binds springFluid (workspaces)" || fail "springFluid binding missing from look.lua"

    accent=$(tv accent | tr -d '"#'); border=$(tv border | tr -d '"#'); text=$(tv text | tr -d '"#')
    grep -qi "$accent" "$look" && ok "accent #$accent in Hyprland active border" || fail "accent #$accent missing from look.lua"
    grep -qi "$border" "$look" && ok "border #$border in Hyprland inactive border" || fail "border #$border missing from look.lua"
    # (The light scheme's borders are tuned in look.lua itself, not copied from Theme.qml: see the comment there.)
    for name in text dim bright border accent warn err; do
        hex=$(tv "$name" | tr -d '"#')
        grep -qi "$hex" "$lock" && ok "$name #$hex in hyprlock" || fail "$name #$hex missing from hyprlock.conf"
    done
    grep -q "springPop" "$lock" && ok "springPop curve in hyprlock" || fail "springPop missing from hyprlock.conf"

    # GTK apps: the stylesheets use the same palette as Theme.qml.
    local name hex
    for name in bg surface border text dim bright accent; do
        hex=$(tv "$name" | tr -d '"#')
        if grep -qi "#$hex" "$root"/home/gtk/.config/gtk-4.0/gtk.css "$root"/home/gtk/.config/gtk-3.0/dark.css; then ok "$name #$hex in the GTK stylesheets"
        else fail "$name #$hex missing from the GTK stylesheets (home/gtk)"; fi
    done
    for name in bg surface border text dim bright accent; do
        hex=$(tvl "$name" | tr -d '"#')
        if grep -qi "#$hex" "$root"/home/gtk/.config/gtk-4.0/gtk.css "$root"/home/gtk/.config/gtk-3.0/light.css; then ok "light $name #$hex in the GTK stylesheets"
        else fail "light $name #$hex missing from the GTK stylesheets (home/gtk)"; fi
    done
    # kitty: one theme file per scheme (it switches between them itself, following the desktop's colour scheme).
    local kdir="$root/home/kitty/.config/kitty"
    for name in bg text border accent; do
        hex=$(tv "$name" | tr -d '"#')
        grep -qi "#$hex" "$kdir/dark-theme.auto.conf" && ok "$name #$hex in kitty's dark theme" || fail "$name #$hex missing from kitty's dark-theme.auto.conf"
        hex=$(tvl "$name" | tr -d '"#')
        grep -qi "#$hex" "$kdir/light-theme.auto.conf" && ok "light $name #$hex in kitty's light theme" || fail "light $name #$hex missing from kitty's light-theme.auto.conf"
    done
    # Neovim's colour scheme keeps a copy of the palette.
    local mono="$root/home/nvim/.config/nvim/colors/mono.lua"
    if [ -f "$mono" ]; then
        for name in bg surface raised border text dim accent err warn; do
            hex=$(tv "$name" | tr -d '"#')
            grep -qi "#$hex" "$mono" && ok "$name #$hex in Neovim's colours" || fail "$name #$hex missing from home/nvim/.config/nvim/colors/mono.lua"
            hex=$(tvl "$name" | tr -d '"#')
            grep -qi "#$hex" "$mono" && ok "light $name #$hex in Neovim's colours" || fail "light $name #$hex missing from home/nvim/.config/nvim/colors/mono.lua"
        done
    fi

    # The login screen (SDDM) keeps copies of the dark palette, corners and spring stiffness (like the lock screen, it has no light version:
    # both are light text over the darkened wallpaper).
    local sddm="$root/system/sddm/carbon/Main.qml"
    if [ -f "$sddm" ]; then
        for name in bg raised border text dim bright accent err; do
            hex=$(tv "$name" | tr -d '"#')
            grep -qi "\"#$hex\"" "$sddm" && ok "$name #$hex in the login screen" || fail "$name #$hex missing from system/sddm/carbon/Main.qml"
        done
        local snappy; snappy=$(tv springSnappy)
        grep -qE "(spring|springSnappy) *: *$snappy\b" "$sddm" && ok "springSnappy $snappy in the login screen" || fail "springSnappy ${snappy:-?} missing from system/sddm/carbon/Main.qml"
    fi
    # (The shell keeps its own 12 px base; it is deliberately not tied to kitty's 11.5 pt.)
    local fam; fam=$(sed -nE 's/^ *readonly property string fontFamily: *"([^"]+)".*/\1/p' "$theme")
    grep -q "$fam" "$kitty" && ok "font \"$fam\" in kitty" || fail "kitty does not use \"$fam\""
    grep -q "$fam" "$lock"  && ok "font \"$fam\" in hyprlock" || fail "hyprlock does not use \"$fam\""
}

# ---------------------------------------------------------------------------------------------------------
layers() {
    hyprctl layers -j 2>/dev/null | python3 -c '
import json, sys
for mon in json.load(sys.stdin).values():
    for lvl in mon["levels"].values():
        for l in lvl:
            if l["namespace"].startswith("quickshell-"): print(l["namespace"])'
    hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
for c in json.load(sys.stdin):
    if c.get("class") == "org.quickshell" and c.get("title") == "Settings" and c.get("mapped"):
        print("quickshell-settings")'
}

# Poll until namespace $1 is gone; echo the milliseconds it took (or "stuck").
time_gone() {
    local ns=$1 t0 t
    t0=$(date +%s%N)
    while layers | grep -qx "$ns"; do
        t=$(( ($(date +%s%N) - t0) / 1000000 ))
        [ "$t" -gt 3000 ] && { echo stuck; return; }
        sleep 0.01
    done
    echo $(( ($(date +%s%N) - t0) / 1000000 ))
}

live() {
    echo "live: open / close every floating surface"
    command -v qs >/dev/null && command -v hyprctl >/dev/null && hyprctl layers >/dev/null 2>&1 || { fail "needs a running Hyprland session with quickshell"; return; }

    # Start from a quiet desktop: close the panel/settings and wait (up to 3 s) for every pop-up to unmap.
    qs ipc call panel close >/dev/null 2>&1
    qs ipc call settings close >/dev/null 2>&1
    local i
    for i in $(seq 300); do layers | grep -qE 'quickshell-(launcher|apps|clipboard|settings|pairing|power|center|panel|osd|notifications|traymenu|handwriting)$' || break; sleep 0.01; done
    local before; before=$(layers | sort -u | tr '\n' ' ')
    local limit=$(( $(tv durFast) + 400 ))   # exit animation + the window's own linger + a frame or two

    # target:function:namespace
    local item target fn ns res
    for item in launcher:toggle:quickshell-launcher apps:toggle:quickshell-apps clipboard:toggle:quickshell-clipboard panel:toggle:quickshell-panel settings:toggle:quickshell-settings power:toggle:quickshell-power notifications:toggle:quickshell-center handwriting:toggle:quickshell-handwriting; do
        IFS=: read -r target fn ns <<<"$item"
        if [ "$target" = handwriting ] && ! qs ipc call handwriting status 2>/dev/null | grep -q '"active":true'; then
            ok "handwriting: skipped (disabled in Settings or no tablet connected)"
            continue
        fi
        qs ipc call "$target" "$fn" >/dev/null 2>&1; sleep 0.6
        if layers | grep -qx "$ns"; then
            qs ipc call "$target" "$fn" >/dev/null 2>&1
            res=$(time_gone "$ns")
            if [ "$res" = stuck ]; then fail "$target: window still mapped 3 s after closing"
            elif [ "$res" -gt "$limit" ]; then fail "$target: took $res ms to unmap (limit $limit ms)"
            else ok "$target: opened, unmapped ${res} ms after closing"; fi
        else
            fail "$target: did not open (no $ns layer)"
            qs ipc call "$target" "$fn" >/dev/null 2>&1
        fi
        sleep 0.4
    done

    sleep 0.5
    local after; after=$(layers | sort -u | tr '\n' ' ')
    [ "$before" = "$after" ] && ok "nothing left behind (layers: ${after:-none})" || fail "layers changed: before [$before] after [$after]"

    echo "live: quickshell log"
    local errs
    # Only the shell that is running now: earlier ones (before a restart) may have logged errors that are already fixed.
    local pid; pid=$(systemctl --user show -p MainPID --value quickshell 2>/dev/null)
    errs=$(journalctl --user -u quickshell --since "-10 min" --no-pager 2>/dev/null | grep -F "quickshell[$pid]" | grep -E "ERROR|WARN" | grep -vE "Reloading|qt\.svg\.draw|sni\.watcher" | tail -5)
    [ -z "$errs" ] && ok "no errors or warnings from the running shell (pid $pid) in the last 10 minutes" || { fail "quickshell logged problems:"; printf '%s\n' "$errs" | cut -c1-200 | sed 's/^/          /'; }
}

case "${1:-all}" in
    static) static ;;
    live)   live ;;
    all)    static; live ;;
    *)      sed -n '2,10p' "$0"; exit 2 ;;
esac

echo; [ "$fails" -eq 0 ] && echo "all checks passed" || echo "$fails check(s) failed"
exit "$fails"
