// fastfetch: `fastfetch`. Colours are the terminal's own palette slots (blue = the pewter), so it follows light / dark.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": { "separator": "  ", "key": { "width": 12 }, "color": { "keys": "blue", "title": "blue" } },
  "modules": [
    "title",
    "break",
    { "type": "os", "key": "os", "format": "{name} {version-id}" },
    { "type": "command", "key": "installed", "shell": "bash", "text": "t=$(stat -c %W /); n=$(( ($(date +%s) - t) / 86400 )); echo \"$(date -d @$t '+%d %b %Y') · $n day$([ $n = 1 ] || echo s)\"" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages" },
    "break",
    { "type": "host", "key": "host", "format": "{version}" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery", "format": "{capacity} {status}" },
    "break",
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "terminal", "key": "terminal" },
    { "type": "font", "key": "font" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
