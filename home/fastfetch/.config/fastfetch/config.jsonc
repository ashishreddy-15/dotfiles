// fastfetch: `fastfetch`. Colours are the terminal's own palette slots (blue = the pewter, 8 = dim, 2 / 3 / 1 = ok / warn
// / err like the bar), so it follows light / dark. Three ruled sections, everything on a two-column gutter; the meters are
// one colour each (by level), then the percentage, then the amounts.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "",
    "key": { "width": 14 },
    "color": { "keys": "blue", "title": "blue" },
    "size": { "ndigits": 1 },
    "percent": { "type": 27, "green": "32", "yellow": "33", "red": "31" },
    "bar": { "char": { "elapsed": "━", "total": "━" }, "width": 12, "border": { "left": "", "right": "" }, "color": { "total": "90" } }
  },
  "modules": [
    "break",
    { "type": "title", "format": "  {#1}{#34}{user-name}{#}{#90}@{#}{#1}{host-name}{#}" },
    "break",
    { "type": "custom", "format": "  {#90}── {#}{#1}system{#}{#90} ───────────────────────────────────" },
    { "type": "os", "key": "  os", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "  kernel", "format": "{release}" },
    { "type": "packages", "key": "  packages", "format": "{rpm} rpm {#90}·{#} {flatpak-user} flatpak" },
    { "type": "uptime", "key": "  uptime", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    { "type": "command", "key": "  installed", "shell": "bash", "text": "t=$(stat -c %W /); n=$(( ($(date +%s) - t) / 86400 )); printf '%s \\e[90m·\\e[0m %s day%s' \"$(date -d @$t '+%d %b %Y')\" $n $([ $n = 1 ] || echo s)" },
    "break",
    { "type": "custom", "format": "  {#90}── {#}{#1}hardware{#}{#90} ─────────────────────────────────" },
    { "type": "host", "key": "  host", "format": "{version}" },
    { "type": "command", "key": "  cpu", "shell": "bash", "text": "c=$(sed -n 's/^model name[^:]*: //p;T;q' /proc/cpuinfo | sed -E 's/\\((R|TM)\\)//g; s/ CPU| @.*//g'); printf '%s \\e[90m·\\e[0m %s threads' \"$c\" $(nproc)" },
    { "type": "gpu", "key": "  gpu", "format": "{name}" },
    { "type": "memory", "key": "  memory", "format": "{percentage-bar}  {used} / {total} {#90}·{#} {percentage}" },
    { "type": "disk", "key": "  disk", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total} {#90}·{#} {size-percentage}" },
    { "type": "battery", "key": "  battery", "format": "{capacity-bar}  {capacity} {#90}·{#} {status}" },
    "break",
    { "type": "custom", "format": "  {#90}── {#}{#1}desktop{#}{#90} ──────────────────────────────────" },
    { "type": "wm", "key": "  wm", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "  terminal", "format": "{pretty-name} {version}" },
    { "type": "shell", "key": "  shell", "format": "{pretty-name} {version}" },
    { "type": "font", "key": "  font", "format": "{font4}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
