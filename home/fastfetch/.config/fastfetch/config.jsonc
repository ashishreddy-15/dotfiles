// fastfetch: `fastfetch`. Colours are the terminal's own palette slots (blue = the pewter, 8 = dim, 2 / 3 / 1 = ok / warn
// / err like the bar), so it follows light / dark.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "",
    "key": { "width": 12 },
    "color": { "keys": "blue", "title": "blue" },
    "percent": { "type": 3, "green": "32", "yellow": "33", "red": "31" },
    "bar": { "char": { "elapsed": "━", "total": "─" }, "width": 10, "border": { "left": "", "right": "" }, "color": { "total": "90" } }
  },
  "modules": [
    "break",
    "title",
    { "type": "custom", "format": "{#90}────────────────────────────────────" },
    { "type": "os", "key": "os", "format": "{name} {version-id}" },
    { "type": "command", "key": "installed", "shell": "bash", "text": "t=$(stat -c %W /); n=$(( ($(date +%s) - t) / 86400 )); printf '%s  \\e[90m·\\e[0m %s day%s' \"$(date -d @$t '+%d %b %Y')\" $n $([ $n = 1 ] || echo s)" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages", "format": "{rpm} rpm  {#90}·{#} {flatpak-user} flatpak" },
    "break",
    { "type": "host", "key": "host", "format": "{version}" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "memory", "format": "{percentage-bar}  {used} / {total}  ({percentage})" },
    { "type": "disk", "key": "disk", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total}  ({size-percentage})" },
    { "type": "battery", "key": "battery", "format": "{capacity-bar}  {capacity}  {status}" },
    "break",
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "terminal", "key": "terminal" },
    { "type": "font", "key": "font", "format": "{combined}" },
    "break",
    { "type": "colors", "key": " ", "symbol": "circle", "paddingLeft": 0 },
    "break"
  ]
}
