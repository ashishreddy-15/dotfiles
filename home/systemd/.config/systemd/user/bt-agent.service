# Bluetooth pairing agent: puts BlueZ's pairing questions to you in the shell (see home/bin/.local/bin/bt-agent).
# Started on demand by Settings > Bluetooth (Pairing.qml) so Python/PyGObject does not sit in RAM at idle.
#   journalctl --user -u bt-agent -f
[Unit]
Description=Bluetooth pairing agent (asks through the shell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/bt-agent
Restart=on-failure
RestartSec=2
