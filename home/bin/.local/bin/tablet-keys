#!/usr/bin/env python3
"""tablet-keys: the ExpressKeys of a pen tablet, each turned into an action you choose in Settings > Tablet.

    tablet-keys /dev/input/eventN      read that pad (started by tablet-keys@eventN.service while it is plugged in)
    tablet-keys --actions              list the actions, as "id<TAB>label" lines (Settings shows these)

It waits for key presses (no CPU while idle) and reads your choices from ~/.local/state/dotfiles/tablet.json at each
press, so a change in Settings applies at once. Shortcuts go to the window that has focus, through Hyprland.
"""
import json, os, signal, struct, subprocess, sys

# id: (label, what to do). A shortcut ("CTRL SHIFT", "p") is handed by Hyprland straight to the focused window
# (its send_shortcut dispatcher): no virtual keyboard, so it reaches native Wayland and XWayland apps alike.
# The shortcuts are Xournal++'s; most apps use the same ones for undo / redo / zoom.
ACTIONS = {
    "none":        ("Nothing",            None),
    "undo":        ("Undo",               ("CTRL", "z")),
    "redo":        ("Redo",               ("CTRL", "y")),
    "pen":         ("Pen",                ("CTRL SHIFT", "p")),
    "eraser":      ("Eraser",             ("CTRL SHIFT", "e")),
    "highlighter": ("Highlighter",        ("CTRL SHIFT", "h")),
    "hand":        ("Hand (move page)",   ("CTRL SHIFT", "a")),
    "select":      ("Select",             ("CTRL SHIFT", "r")),
    "zoom-in":     ("Zoom in",            ("CTRL", "equal")),
    "zoom-out":    ("Zoom out",           ("CTRL", "minus")),
    "screenshot":  ("Screenshot",         [os.path.expanduser("~/.local/bin/screenshot")]),
}
# For testing: send shortcuts to this window instead of the focused one (e.g. "class:__nothing__").
TARGET = os.environ.get("TABLET_KEYS_WINDOW", "")

def run(what):
    if isinstance(what, tuple):
        mods, key = what
        target = f', window = "{TARGET}"' if TARGET else ""
        cmd = ["hyprctl", "dispatch", f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "{key}"{target} }})']
    else:
        cmd = what
    return subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE if TARGET else subprocess.DEVNULL,
                            stderr=subprocess.STDOUT if TARGET else subprocess.DEVNULL, text=True)

DEFAULT = ["undo", "redo", "pen", "eraser"]
STATE = os.path.expanduser("~/.local/state/dotfiles/tablet.json")
BTN_0 = 0x100                                    # the pad's keys are BTN_0, BTN_1, ...
EV_KEY = 1
EVENT = struct.Struct("llHHi")                   # struct input_event: time (2 longs), type, code, value

def chosen():
    try:
        keys = json.load(open(STATE)).get("expressKeys")
        if isinstance(keys, list) and keys: return keys
    except (OSError, ValueError):
        pass
    return DEFAULT

def main(argv):
    if argv[:1] == ["--actions"]:
        for k, (label, _) in ACTIONS.items(): print(f"{k}\t{label}")
        return
    if len(argv) != 1: sys.exit(__doc__)
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)   # actions are not waited for: let the kernel clean them up
    with open(argv[0], "rb", buffering=0) as dev:
        while True:
            data = dev.read(EVENT.size)
            if len(data) < EVENT.size: break     # the pad went away
            _, _, etype, code, value = EVENT.unpack(data)
            if etype != EV_KEY or value != 1 or not (BTN_0 <= code < BTN_0 + 16): continue
            index = code - BTN_0
            keys = chosen()
            action = keys[index] if index < len(keys) else "none"
            what = ACTIONS.get(action, ("", None))[1]
            print(f"key {index + 1}: {action}", flush=True)
            if what:
                proc = run(what)
                if TARGET: print("   ->", proc.communicate()[0].strip(), flush=True)

if __name__ == "__main__":
    main(sys.argv[1:])
