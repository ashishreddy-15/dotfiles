#!/usr/bin/env python3
"""hw-ocr: client for the local handwriting-recognition daemon (socket $XDG_RUNTIME_DIR/hw-ocr.sock).

  hw-ocr /path/to/line.png    print the recognised text
  hw-ocr warm                 load the model now (so the next request is fast)
  hw-ocr -j ...               print the raw JSON reply
Starting the daemon is systemd's job (hw-ocr.socket); see docs/system.md.
"""
import json, os, socket, sys

args = sys.argv[1:]
raw = "-j" in args
args = [a for a in args if a != "-j"]
if len(args) != 1 or args[0] in ("-h", "--help"):
    sys.exit(__doc__)
req = args[0] if args[0] == "warm" else os.path.abspath(args[0])
sock = os.environ.get("HW_SOCK") or os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hw-ocr.sock")
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(float(os.environ.get("HW_TIMEOUT", "120")))
try:
    s.connect(sock)
    s.sendall(req.encode() + b"\n")
    buf = b""
    while not buf.endswith(b"\n"):
        d = s.recv(65536)
        if not d:
            break
        buf += d
except OSError as e:
    sys.exit(f"hw-ocr: {e} (is hw-ocr.socket enabled? ./install.sh services)")
if raw:
    sys.stdout.write(buf.decode()); sys.exit(0)
r = json.loads(buf or b'{"error":"empty reply"}')
if "error" in r:
    sys.exit("hw-ocr: " + r["error"])
if "text" in r:
    print(r["text"])
