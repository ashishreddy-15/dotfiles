#!/usr/bin/env bash
# screenrecord: record the screen to a video. Press the key again (or click the red "rec" in the bar) to stop.
#
#   screenrecord                drag a region or click a window, then record it          Super + Shift + R
#   screenrecord screen         record the focused monitor                               Super + Ctrl + R
#   ... --audio                 also record what the computer plays (e.g. screenrecord screen --audio)
#   screenrecord stop           stop (any start command also stops a recording that is running)
#   screenrecord status         "recording <start time>" or "idle" (the bar asks this when the shell starts)
#
# Videos go to ~/Videos/Recordings/ (MP4, H.264), and a notification says when one is saved. The shell shows a red
# "rec 0:12" in the bar while recording (`qs ipc call recording started|stopped`, see bar/Recording.qml).
set -u

state="${XDG_RUNTIME_DIR:-/tmp}/screenrecord"          # pid, file and start time of the running recording
dir="$HOME/Videos/Recordings"

running() { [ -f "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null; }

stop() {
    if ! running; then rm -rf "$state"; qs ipc call recording stopped >/dev/null 2>&1; return 0; fi
    kill -INT "$(cat "$state/pid")"                      # wf-recorder finishes the file on SIGINT
    for _ in $(seq 100); do running || break; sleep 0.1; done
    local file; file=$(cat "$state/file")
    rm -rf "$state"
    qs ipc call recording stopped >/dev/null 2>&1
    if [ -s "$file" ]; then
        notify-send -a "Screen recording" "Recording saved" "~/Videos/Recordings/$(basename "$file")"
    else
        notify-send -a "Screen recording" -u critical "Recording failed" "Nothing was saved (see $state.log)"
    fi
}

mode=region audio=0
for arg in "$@"; do
    case $arg in
        stop)    stop; exit 0 ;;
        status)  if running; then echo "recording $(cat "$state/since")"; else echo idle; fi; exit 0 ;;
        region|screen) mode=$arg ;;
        --audio) audio=1 ;;
        *)       sed -n '2,12p' "$0"; exit 2 ;;
    esac
done

# A start command while recording stops it: the same key starts and stops.
if running; then stop; exit 0; fi

args=()
case $mode in
    region)
        boxes=$(hyprctl -j monitors | python3 -c '
import json, subprocess, sys
active = {m["activeWorkspace"]["id"] for m in json.load(sys.stdin)}
for c in json.loads(subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True).stdout):
    if c["workspace"]["id"] in active and c.get("mapped", True) and not c.get("hidden", False):
        (x, y), (w, h) = c["at"], c["size"]
        print(f"{x},{y} {w}x{h}")')
        geometry=$(printf '%s\n' "$boxes" | slurp -b '#11111166' -c '#a67a7eff' -s '#a67a7e22' -B '#d0d3d614' -w 1) || exit 0
        # H.264 needs an even width and height.
        read -r pos size <<<"$geometry"
        w=${size%x*}; h=${size#*x}
        geometry="$pos $((w / 2 * 2))x$((h / 2 * 2))"
        args+=(-g "$geometry")
        ;;
    screen)
        args+=(-o "$(hyprctl -j monitors | python3 -c 'import json,sys; print(next(m["name"] for m in json.load(sys.stdin) if m["focused"]))')")
        ;;
esac
(( audio )) && args+=(--audio="$(pactl get-default-sink).monitor")

mkdir -p "$dir" "$state"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"
setsid wf-recorder "${args[@]}" -c libx264 -p preset=veryfast -p crf=22 -x yuv420p -f "$file" >"$state.log" 2>&1 &
echo $! >"$state/pid"
echo "$file" >"$state/file"
date +%s >"$state/since"

sleep 0.5
if ! running; then
    rm -rf "$state"
    notify-send -a "Screen recording" -u critical "Could not start recording" "$(tail -n 2 "$state.log")"
    exit 1
fi
qs ipc call recording started "$(cat "$state/since")" >/dev/null 2>&1
exit 0
